#!/bin/sh
# Refuse commits that would publish private learner data.
# Enable once per clone: git config core.hooksPath scripts/hooks
repository_root=$(git rev-parse --show-toplevel)
python="$repository_root/.venv/bin/python"
if [ ! -x "$python" ]; then
    python=python3
fi
exec "$python" "$repository_root/scripts/check_private_data.py"
